# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres 
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the 
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.

ORIGIN=http://localhost:3000


# Prisma Database Connection
DATABASE_HOST="postgres"
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DATABASE_HOST}:5432/${POSTGRES_DB}?schema=public

# Set to "true" to enable the local email/password login form on the login page.
PUBLIC_AUTH_PROVIDER_LOCAL_ENABLED="false"

# --- Authentication Providers ---
# Relaypoint can use any OAuth/OIDC provider supported by Auth.js
# (https://authjs.dev/getting-started/providers), configured entirely
# through environment variables — no code changes required.
#
# 1. List which providers to enable as a comma-separated set of Auth.js
#    provider ids (the filenames under https://github.com/nextauthjs/next-auth/tree/main/packages/core/src/providers):
AUTH_PROVIDERS="github"
#
# 2. For each enabled provider, set its credentials using Auth.js's standard
#    env var convention: AUTH_<PROVIDERID>_ID, AUTH_<PROVIDERID>_SECRET, and
#    (for OIDC providers) AUTH_<PROVIDERID>_ISSUER, where <PROVIDERID> is the
#    provider id upper-cased with "-" replaced by "_". For example:
#      AUTH_PROVIDERS="keycloak,google,github"
#      AUTH_GOOGLE_ID="..."
#      AUTH_GOOGLE_SECRET="..."
#      AUTH_GITHUB_ID="..."
#      AUTH_GITHUB_SECRET="..."
#
# 3. If your identity provider isn't in Auth.js's built-in catalog (e.g. a
#    self-hosted/custom OIDC issuer), you can add a generic OIDC provider
#    instead of/in addition to the above:
# AUTH_CUSTOM_OIDC_NAME="My SSO"
# AUTH_CUSTOM_OIDC_ISSUER="https://sso.example.com"
# AUTH_CUSTOM_OIDC_ID="..."
# AUTH_CUSTOM_OIDC_SECRET="..."
#
# See src/lib/server/authProviders.ts for the full mechanism.

APP_URL="localhost:5173"

# --- Auth.js Core Settings ---
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# --- Example OAuth Provider Credentials ---
# Uncomment and fill in the credentials for the provider(s) you enabled in
# AUTH_PROVIDERS. Example using GitHub (create an OAuth app at
# https://github.com/settings/developers, callback URL:
# <your-origin>/api/auth/callback/github):
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
#
# Example using a self-hosted Keycloak realm:
# AUTH_PROVIDERS="keycloak"
# AUTH_KEYCLOAK_ID="relaypoint"
# AUTH_KEYCLOAK_SECRET=""
# AUTH_KEYCLOAK_ISSUER="https://sso.example.com/realms/my-realm"

# Database 
POSTGRES_USER="relaypoint"
POSTGRES_PASSWORD=""
POSTGRES_DB="relaypoint"

# --- S3 Connection Details for SvelteKit App ---
# Inside the Docker network, we connect to the service name 's3' on its API port.
S3_ACCESS_KEY=
S3_SECRET_KEY=

PUBLIC_S3_ENDPOINT=http://s3:9000
PUBLIC_S3_BUCKET_NAME=relaypoint
PUBLIC_S3_REGION=us-east-1

# --- Gotenberg (used to convert uploaded PowerPoint files to PDF before rasterizing to slide images) ---
# Inside the Docker network, this points at the `gotenberg` service.
GOTENBERG_URL=http://gotenberg:3000

# The organization name, e.g. ODU or Google
PUBLIC_ORGANIZATION_NAME=""

# 2 gb
BODY_SIZE_LIMIT=2147483648