# RelayPoint configuration
# ========================
# Copy to `.env` and fill in the blanks. docker-compose reads this file for
# both the app container and the bundled Postgres/MinIO services.
#
# Variable names without the PUBLIC_ prefix are server-only and never sent
# to the browser. PUBLIC_* variables are visible to anyone who loads the app.

# --- Core URLs -------------------------------------------------------------
# The public origin users (and displays) hit, e.g. https://signage.example.com
# Used for absolute links, OAuth callbacks and WebSocket URLs.
ORIGIN=http://localhost:3000

# Kept for compatibility; should match ORIGIN (include the scheme).
APP_URL=http://localhost:3000

# Shown in the dashboard header, e.g. "Example Corp"
PUBLIC_ORGANIZATION_NAME="My Organization"

# --- Database (Postgres) ----------------------------------------------------
POSTGRES_USER="relaypoint"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="relaypoint"
DATABASE_HOST="postgres"
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DATABASE_HOST}:5432/${POSTGRES_DB}?schema=public

# --- Object storage (S3-compatible) -----------------------------------------
# Any S3-compatible endpoint works (MinIO, Cloudflare R2, AWS S3, ...).
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
PUBLIC_S3_ENDPOINT=http://s3:9000
PUBLIC_S3_BUCKET_NAME=relaypoint
PUBLIC_S3_REGION=us-east-1

# --- PowerPoint conversion (optional) ---------------------------------------
# Gotenberg converts uploaded .ppt/.pptx files to images. Uploads still work
# without it — those files are rejected with a clear error message.
GOTENBERG_URL=http://gotenberg:3000

# --- Upload limits -----------------------------------------------------------
# MAX_UPLOAD_BYTES_MB caps the slide upload size enforced by the app itself.
MAX_UPLOAD_BYTES_MB="1024"
# adapter-node also enforces a global HTTP body cap *before* routing; it must
# be at least as large as MAX_UPLOAD_BYTES_MB or large uploads fail with 413.
# (Suffixes K/M/G accepted.) 2 GiB default:
BODY_SIZE_LIMIT=2147483648

# --- Auth.js core ------------------------------------------------------------
# REQUIRED. A random string used to sign session cookies/secrets:
#   openssl rand -base64 32
AUTH_SECRET=""
# Required when running behind a reverse proxy (almost always true in Docker).
AUTH_TRUST_HOST="true"

# --- Sign-in providers -------------------------------------------------------
# RelayPoint supports any OAuth/OIDC provider from the Auth.js catalog via
# env vars alone (no code changes):
#
#   AUTH_PROVIDERS="keycloak,google,github"
#   AUTH_GOOGLE_ID="..."        AUTH_GOOGLE_SECRET="..."
#   AUTH_GITHUB_ID="..."        AUTH_GITHUB_SECRET="..."
#
# Provider id rules: AUTH_<PROVIDERID>_ID / _SECRET / (OIDC only) _ISSUER,
# where <PROVIDERID> is the provider id upper-cased, "-" replaced by "_".
# Callback URL for a provider: <ORIGIN>/api/auth/callback/<provider-id>
AUTH_PROVIDERS=""

# Custom/self-hosted OIDC provider not in the Auth.js catalog:
# AUTH_CUSTOM_OIDC_NAME="My SSO"
# AUTH_CUSTOM_OIDC_ISSUER="https://sso.example.com/realms/main"
# AUTH_CUSTOM_OIDC_ID="relaypoint"
# AUTH_CUSTOM_OIDC_SECRET="..."

# --- Local email/password login ---------------------------------------------
# When NO OAuth/OIDC provider is configured, local login is enabled
# automatically so a fresh install can sign in. Set explicitly to override:
#   AUTH_LOCAL_ENABLED=false   -> always off (SSO only)
#   AUTH_LOCAL_ENABLED=true    -> on even alongside SSO
# AUTH_LOCAL_ENABLED="true"
#
# Allow anyone to self-register. Off by default: only the very first local
# account can be created (it becomes the admin). Turn on for open signups.
AUTH_LOCAL_ALLOW_SIGNUP="false"

# --- Role mapping (OAuth/OIDC) -------------------------------------------------
# Users with this group/role in their ID token are promoted to ADMIN on
# login. Reads the `groups` or `realm_access.roles` claims (case-insensitive).
# Unset = feature off (the first user created still becomes admin).
# AUTH_ADMIN_GROUP="syskids"

# --- Dangerous opt-ins ---------------------------------------------------------
# Link OAuth accounts to existing local accounts with the same email address.
# Only enable if the same trusted IdP owns both — otherwise it lets an attacker
# pre-create an account at a victim's email and get linked-in. Off by default.
# AUTH_ALLOW_EMAIL_ACCOUNT_LINKING="true"
